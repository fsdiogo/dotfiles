# Theme
theme = Catppuccin Macchiato

# Fonts
font-family = JetBrainsMono Nerd Font Mono
font-size = 14
font-thicken = true
bold-color = bright
font-feature = -calt
font-feature = -liga
font-feature = -dlig

# Layout & Experience
adjust-cell-height = 1
window-padding-x = 10
window-padding-y = 10

# Cursor
cursor-style = underline
cursor-style-blink = false
shell-integration-features = no-cursor
